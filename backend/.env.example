# Copy to .env and fill in. Direct (non-pooled) PostgreSQL URLs: migrations and row locks need a direct connection.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/leaddesk?sslmode=require"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/leaddesk_test?sslmode=require"
JWT_ACCESS_SECRET="long-random-string"
JWT_REFRESH_SECRET="another-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV=development
# Web Push (optional). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
