// LeadDesk data model. Source of truth: docs/SYSTEM-DESIGN.md §4.
// Rules: money in paise (BigInt), percentages in basis points (Int), times in UTC.
// History tables are append-only: assignments, status history, attendance corrections, finance.
// Partial unique indexes and views that Prisma cannot express live in the migration SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEAM_LEAD
  BDE
}

enum UserState {
  ACTIVE
  INACTIVE
  EXITED
}

enum TeamState {
  ACTIVE
  INACTIVE
}

enum StatusCategory {
  OPEN
  WON
  LOST
  EXCLUDED
}

enum AssignLevel {
  TEAM
  BDE
}

enum AllocMethod {
  EQUAL
  CAPACITY
  WORKLOAD
  SMART
  MANUAL
  AUTO_REFILL
  RECYCLE
}

enum EndReason {
  REASSIGNED
  USER_INACTIVE
  USER_EXITED
  TRANSFERRED
  RECYCLED
  CLOSED
  TAKEN_BACK
  UNDONE
}

enum Channel {
  CALL
  WHATSAPP
}

enum FollowUpType {
  CALL
  WHATSAPP
  MEETING
  TASK
}

enum FollowUpState {
  PENDING
  DONE
  CANCELLED
}

enum DayStatus {
  PRESENT
  HALF_DAY
  ABSENT
  LEAVE
  HOLIDAY
  WEEK_OFF
}

enum RequestState {
  PENDING
  APPROVED
  REJECTED
}

enum Scope {
  COMPANY
  TEAM
  USER
}

enum TxnKind {
  REVENUE
  INVESTMENT
}

enum TxnState {
  PENDING
  CONFIRMED
  CANCELLED
}

enum CalcType {
  REVENUE_SHARE
  PROFIT_SHARE
  PERCENT_OF
  DISCOUNT
  CHANGE
  GROWTH
}

enum BulkKind {
  ASSIGN
  STATUS
  DELETE
  IMPORT
}

// ---------- 4.1 People and teams ----------

model User {
  id                 Int       @id @default(autoincrement())
  empCode            String    @unique @map("emp_code")
  name               String
  email              String    @unique
  phone              String?
  role               Role
  state              UserState @default(ACTIVE)
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  failedLogins       Int       @default(0) @map("failed_logins")
  lockedUntil        DateTime? @map("locked_until")
  tokenVersion       Int       @default(0) @map("token_version")
  joinedOn           DateTime  @default(now()) @db.Date @map("joined_on")
  exitedOn           DateTime? @db.Date @map("exited_on")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  memberships   TeamMembership[]
  leadLinks     TeamLeadLink[]
  ownedLeads    Lead[]           @relation("LeadOwner")
  matchValues   UserMatchValue[]
  attendance    Attendance[]
  notifications Notification[]

  @@map("users")
}

model Team {
  id             Int       @id @default(autoincrement())
  name           String    @unique
  state          TeamState @default(ACTIVE)
  autoDistribute Boolean   @default(false) @map("auto_distribute")
  method         AllocMethod @default(SMART)
  createdAt      DateTime  @default(now()) @map("created_at")

  memberships TeamMembership[]
  leadLinks   TeamLeadLink[]
  leads       Lead[]

  @@map("teams")
}

model TeamMembership {
  id     Int       @id @default(autoincrement())
  teamId Int       @map("team_id")
  userId Int       @map("user_id")
  fromAt DateTime  @default(now()) @map("from_at")
  toAt   DateTime? @map("to_at")
  team   Team      @relation(fields: [teamId], references: [id])
  user   User      @relation(fields: [userId], references: [id])

  @@index([teamId])
  @@map("team_memberships")
}

model TeamLeadLink {
  id     Int       @id @default(autoincrement())
  teamId Int       @map("team_id")
  userId Int       @map("user_id")
  fromAt DateTime  @default(now()) @map("from_at")
  toAt   DateTime? @map("to_at")
  team   Team      @relation(fields: [teamId], references: [id])
  user   User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("team_lead_links")
}

// ---------- 4.2 Leads ----------

model LeadSource {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)
  leads  Lead[]

  @@map("lead_sources")
}

model ImportBatch {
  id         Int      @id @default(autoincrement())
  fileName   String   @map("file_name")
  uploadedBy Int      @map("uploaded_by")
  totalRows  Int      @map("total_rows")
  accepted   Int
  duplicates Int
  rejected   Int
  mapping    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  rejects ImportReject[]
  leads   Lead[]

  @@map("import_batches")
}

model ImportReject {
  id        Int         @id @default(autoincrement())
  batchId   Int         @map("batch_id")
  rowNumber Int         @map("row_number")
  raw       Json
  reason    String
  kind      String      @default("ERROR") // ERROR | DUPLICATE
  existingLeadId Int?   @map("existing_lead_id")
  batch     ImportBatch @relation(fields: [batchId], references: [id])

  @@index([batchId])
  @@map("import_rejects")
}

model Lead {
  id              Int       @id @default(autoincrement())
  name            String
  phoneE164       String    @map("phone_e164")
  email           String?
  sourceId        Int?      @map("source_id")
  batchId         Int?      @map("batch_id")
  custom          Json      @default("{}")
  statusId        Int       @map("status_id")
  score           Int       @default(0)
  teamId          Int?      @map("team_id")
  ownerId         Int?      @map("owner_id")
  attemptCount    Int       @default(0) @map("attempt_count")
  firstAttemptAt  DateTime? @map("first_attempt_at")
  recycleCount    Int       @default(0) @map("recycle_count")
  dnd             Boolean   @default(false)
  lastActivityAt  DateTime? @map("last_activity_at")
  nextFollowUpAt  DateTime? @map("next_follow_up_at")
  statusChangedAt DateTime  @default(now()) @map("status_changed_at")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       Int?      @map("deleted_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  version         Int       @default(0)

  source      LeadSource?      @relation(fields: [sourceId], references: [id])
  batch       ImportBatch?     @relation(fields: [batchId], references: [id])
  status      Status           @relation(fields: [statusId], references: [id])
  team        Team?            @relation(fields: [teamId], references: [id])
  owner       User?            @relation("LeadOwner", fields: [ownerId], references: [id])
  assignments LeadAssignment[]
  history     StatusHistory[]
  calls       CallLog[]
  followUps   FollowUp[]
  remarks     LeadRemark[]
  transactions FinTransaction[]

  @@index([teamId, ownerId])
  @@index([ownerId, statusId])
  @@index([email])
  @@map("leads")
}

model CustomFieldDef {
  key        String  @id
  label      String
  type       String  // text | number | date | select
  options    Json?
  required   Boolean @default(false)
  showInList Boolean @default(false) @map("show_in_list")
  order      Int     @default(0)
  active     Boolean @default(true)

  @@map("custom_field_defs")
}

model Status {
  id              Int            @id @default(autoincrement())
  key             String         @unique
  label           String
  category        StatusCategory
  countsAsContact Boolean        @default(false) @map("counts_as_contact")
  needsFollowUp   Boolean        @default(false) @map("needs_follow_up")
  remarksRequired Boolean        @default(false) @map("remarks_required")
  requiredFields  Json           @default("[]") @map("required_fields")
  followUpHours   Int?           @map("follow_up_hours")
  colour          String         @default("#64748b")
  order           Int            @default(0)
  active          Boolean        @default(true)

  leads Lead[]
  from  StatusTransition[] @relation("From")
  to    StatusTransition[] @relation("To")

  @@map("statuses")
}

model StatusTransition {
  fromStatusId Int    @map("from_status_id")
  toStatusId   Int    @map("to_status_id")
  from         Status @relation("From", fields: [fromStatusId], references: [id])
  to           Status @relation("To", fields: [toStatusId], references: [id])

  @@id([fromStatusId, toStatusId])
  @@map("status_transitions")
}

model StatusHistory {
  id           Int      @id @default(autoincrement())
  leadId       Int      @map("lead_id")
  fromStatusId Int?     @map("from_status_id")
  toStatusId   Int      @map("to_status_id")
  byUserId     Int      @map("by_user_id")
  ownerId      Int?     @map("owner_id") // owner at the moment of the change (conversion credit, §9.1)
  teamId       Int?     @map("team_id")
  remarks      String?
  reopen       Boolean  @default(false)
  at           DateTime @default(now())
  lead         Lead     @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@index([toStatusId, at])
  @@map("status_history")
}

model LeadRemark {
  id       Int      @id @default(autoincrement())
  leadId   Int      @map("lead_id")
  byUserId Int      @map("by_user_id")
  body     String
  at       DateTime @default(now())
  lead     Lead     @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@map("lead_remarks")
}

model CallOutcome {
  id              Int     @id @default(autoincrement())
  label           String  @unique
  connected       Boolean
  countsAsAttempt Boolean @map("counts_as_attempt")
  needsFollowUp   Boolean @map("needs_follow_up")
  order           Int     @default(0)
  active          Boolean @default(true)

  @@map("call_outcomes")
}

model CallLog {
  id             Int      @id @default(autoincrement())
  leadId         Int      @map("lead_id")
  userId         Int      @map("user_id")
  channel        Channel  @default(CALL)
  direction      String   @default("OUT")
  startedAt      DateTime @default(now()) @map("started_at")
  durationSec    Int      @default(0) @map("duration_sec")
  outcomeId      Int?     @map("outcome_id")
  statusBeforeId Int?     @map("status_before_id")
  statusAfterId  Int?     @map("status_after_id")
  remarks        String?
  lead           Lead     @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@index([userId, startedAt])
  @@map("call_logs")
}

model FollowUp {
  id          Int           @id @default(autoincrement())
  leadId      Int           @map("lead_id")
  userId      Int           @map("user_id")
  type        FollowUpType  @default(CALL)
  dueAt       DateTime      @map("due_at")
  reason      String?
  state       FollowUpState @default(PENDING)
  auto        Boolean       @default(false)
  remindedAt  DateTime?     @map("reminded_at")
  completedAt DateTime?     @map("completed_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  lead        Lead          @relation(fields: [leadId], references: [id])

  @@index([userId, state, dueAt])
  @@index([leadId, state])
  @@map("follow_ups")
}

model MessageTemplate {
  id      Int     @id @default(autoincrement())
  name    String
  channel Channel @default(WHATSAPP)
  body    String
  active  Boolean @default(true)

  @@map("message_templates")
}

model ScoringRule {
  id       Int     @id @default(autoincrement())
  field    String  // source | status | attempts | custom.<key>
  operator String  // eq | gte | lte
  value    String
  points   Int
  active   Boolean @default(true)

  @@map("scoring_rules")
}

model SavedView {
  id      Int     @id @default(autoincrement())
  userId  Int?    @map("user_id")
  page    String
  name    String
  filters Json
  order   Int     @default(0)

  @@map("saved_views")
}

model BulkAction {
  id        Int       @id @default(autoincrement())
  kind      BulkKind
  byUserId  Int       @map("by_user_id")
  leadCount Int       @map("lead_count")
  before    Json
  runId     Int?      @map("run_id")
  at        DateTime  @default(now())
  undoneAt  DateTime? @map("undone_at")
  undoneBy  Int?      @map("undone_by")

  @@map("bulk_actions")
}

// ---------- 4.3 Allocation ----------

model AllocationRun {
  id        Int         @id @default(autoincrement())
  level     AssignLevel
  method    AllocMethod
  teamId    Int?        @map("team_id")
  startedBy Int?        @map("started_by")
  params    Json        @default("{}")
  leadCount Int         @map("lead_count")
  createdAt DateTime    @default(now()) @map("created_at")

  assignments LeadAssignment[]

  @@map("allocation_runs")
}

model LeadAssignment {
  id         Int         @id @default(autoincrement())
  leadId     Int         @map("lead_id")
  level      AssignLevel
  teamId     Int         @map("team_id")
  userId     Int?        @map("user_id")
  runId      Int?        @map("run_id")
  assignedBy Int?        @map("assigned_by")
  assignedAt DateTime    @default(now()) @map("assigned_at")
  reason     Json        @default("{}")
  overMax    Boolean     @default(false) @map("over_max")
  endedAt    DateTime?   @map("ended_at")
  endReason  EndReason?  @map("end_reason")
  lead       Lead        @relation(fields: [leadId], references: [id])
  run        AllocationRun? @relation(fields: [runId], references: [id])

  @@index([leadId])
  @@index([userId, assignedAt])
  @@index([teamId, assignedAt])
  @@map("lead_assignments")
}

model UserMatchValue {
  userId   Int    @map("user_id")
  fieldKey String @map("field_key")
  value    String
  user     User   @relation(fields: [userId], references: [id])

  @@id([userId, fieldKey, value])
  @@map("user_match_values")
}

model AllocationLimit {
  id        Int   @id @default(autoincrement())
  scope     Scope
  scopeId   Int   @default(0) @map("scope_id")
  maxOpen   Int?  @map("max_open")
  maxPerDay Int?  @map("max_per_day")

  @@unique([scope, scopeId])
  @@map("allocation_limits")
}

// ---------- 4.4 Attendance ----------

model Attendance {
  id              Int        @id @default(autoincrement())
  userId          Int        @map("user_id")
  workDate        DateTime   @db.Date @map("work_date")
  punchInAt       DateTime?  @map("punch_in_at")
  punchOutAt      DateTime?  @map("punch_out_at")
  workedMin       Int        @default(0) @map("worked_min")
  dayStatus       DayStatus? @map("day_status")
  late            Boolean    @default(false)
  earlyOut        Boolean    @default(false) @map("early_out")
  missingPunchOut Boolean    @default(false) @map("missing_punch_out")
  punchInIp       String?    @map("punch_in_ip")
  location        Json?
  user            User       @relation(fields: [userId], references: [id])
  corrections     AttendanceCorrection[]

  @@unique([userId, workDate])
  @@map("attendance")
}

model AttendanceCorrection {
  id           Int          @id @default(autoincrement())
  attendanceId Int          @map("attendance_id")
  requestedBy  Int          @map("requested_by")
  approvedBy   Int?         @map("approved_by")
  before       Json
  after        Json
  reason       String
  state        RequestState @default(PENDING)
  at           DateTime     @default(now())
  decidedAt    DateTime?    @map("decided_at")
  attendance   Attendance   @relation(fields: [attendanceId], references: [id])

  @@map("attendance_corrections")
}

model Holiday {
  date DateTime @id @db.Date
  name String

  @@map("holidays")
}

model TimeOff {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  fromDate  DateTime @db.Date @map("from_date")
  toDate    DateTime @db.Date @map("to_date")
  kind      String   @default("LEAVE")
  enteredBy Int      @map("entered_by")

  @@index([userId])
  @@map("time_off")
}

// ---------- 4.5 Targets, settings, notifications, audit ----------

model Target {
  id       Int      @id @default(autoincrement())
  scope    Scope
  scopeId  Int      @default(0) @map("scope_id")
  metric   String   // calls | contacts | conversions | conversion_pct | revenue
  period   String   // DAY | WEEK | MONTH
  value    BigInt
  fromDate DateTime @db.Date @map("from_date")

  @@map("targets")
}

model Setting {
  key       String   @id
  value     Json
  updatedBy Int?     @map("updated_by")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("settings")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      String
  title     String
  body      String?
  link      String?
  dedupeKey String?   @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@unique([userId, dedupeKey])
  @@map("notifications")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("push_subscriptions")
}

model AuditLog {
  id       BigInt   @id @default(autoincrement())
  actorId  Int?     @map("actor_id")
  action   String
  entity   String
  entityId String?  @map("entity_id")
  before   Json?
  after    Json?
  ip       String?
  at       DateTime @default(now())

  @@index([entity, entityId])
  @@index([at])
  @@map("audit_log")
}

// ---------- 4.6 Finance ----------

model FinTransaction {
  id                Int       @id @default(autoincrement())
  kind              TxnKind
  leadId            Int?      @map("lead_id")
  teamId            Int?      @map("team_id")
  amountPaise       BigInt    @map("amount_paise")
  method            String?
  referenceNo       String?   @map("reference_no")
  receivedOn        DateTime  @db.Date @map("received_on")
  state             TxnState  @default(PENDING)
  recordedBy        Int       @map("recorded_by")
  confirmedBy       Int?      @map("confirmed_by")
  confirmedAt       DateTime? @map("confirmed_at")
  companyShareBp    Int?      @map("company_share_bp")
  companySharePaise BigInt?   @map("company_share_paise")
  remainingPaise    BigInt?   @map("remaining_paise")
  cancelReason      String?   @map("cancel_reason")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  lead              Lead?     @relation(fields: [leadId], references: [id])

  @@index([state, receivedOn])
  @@map("transactions")
}

model FinCalculation {
  id             Int      @id @default(autoincrement())
  type           CalcType
  inputs         Json
  percentBp      Int?     @map("percent_bp")
  resultPaise    BigInt?  @map("result_paise")
  remainingPaise BigInt?  @map("remaining_paise")
  resultBp       Int?     @map("result_bp")
  note           String?
  transactionId  Int?     @map("transaction_id")
  periodFrom     DateTime? @db.Date @map("period_from")
  periodTo       DateTime? @db.Date @map("period_to")
  byUserId       Int      @map("by_user_id")
  at             DateTime @default(now())

  @@index([type, at])
  @@map("fin_calculations")
}
