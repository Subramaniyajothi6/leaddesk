{
  "name": "leaddesk-backend",
  "version": "0.1.0",
  "private": true,
  "description": "LeadDesk API: BDE lead management and allocation (one database per company)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "16.5.0",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "libphonenumber-js": "1.12.10",
    "multer": "2.5.0",
    "papaparse": "5.5.3",
    "pdfmake": "0.2.20",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.0.0",
    "@types/node": "22.15.30",
    "@types/papaparse": "5.3.16",
    "@types/pdfmake": "0.2.11",
    "@types/supertest": "6.0.3",
    "@types/web-push": "3.6.4",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "5.1.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "effect": "3.22.5",
    "uuid": "11.1.1"
  }
}
